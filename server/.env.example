# Server port
PORT=5000

# MongoDB connection string (never commit the real value)
MONGODB_URI=mongodb://127.0.0.1:27017/mini_mern_auth

# Secret used to sign JWTs (use a long random string in development)
JWT_SECRET=replace-with-a-long-random-string

# Initial admin created by `npm run seed:admin`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
